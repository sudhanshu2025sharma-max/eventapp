{% extends "panel/base.html" %}
{% block title %}Error Reports &amp; System Logs — ETD 2026{% endblock %}
{% block page_title %}Error Reports &amp; System Logs{% endblock %}
{% block page_subtitle %}Live system logs, Linux health metrics, and user-submitted bug tickets{% endblock %}

{% block content %}
{% for m in messages %}
<div class="alert alert-{{ m.tags|default:'success' }}"><i class="fas fa-check-circle"></i> {{ m }}</div>
{% endfor %}

<!-- Health & Metric Cards -->
<div class="stats-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 24px;">
  <div class="stat-card">
    <div class="stat-card-header">
      <div class="stat-icon" style="background:#fee2e2; color:#dc2626;"><i class="fas fa-bug"></i></div>
      <span class="stat-trend {% if counts.new > 0 %}up{% else %}pending{% endif %}">{{ counts.new }} New</span>
    </div>
    <div class="stat-value">{{ counts.total }}</div>
    <div class="stat-label">User Error Reports</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width: 100%; background: #dc2626;"></div></div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <div class="stat-icon" style="background:#e8f0fe; color:#1a73e8;"><i class="fas fa-server"></i></div>
      <span class="stat-trend up">Gunicorn Active</span>
    </div>
    <div class="stat-value">{{ health.gunicorn_workers }} Workers</div>
    <div class="stat-label">Uptime: {{ health.uptime }}</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width: 100%; background: #1a73e8;"></div></div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <div class="stat-icon" style="background:#fef3c7; color:#d97706;"><i class="fas fa-memory"></i></div>
      <span class="stat-trend">{{ health.ram_percent }}%</span>
    </div>
    <div class="stat-value">{{ health.ram_used }}</div>
    <div class="stat-label">RAM (Total: {{ health.ram_total }})</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width: {{ health.ram_percent }}%; background: #d97706;"></div></div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <div class="stat-icon" style="background:#e6f9f1; color:#0d9f6e;"><i class="fas fa-database"></i></div>
      <span class="stat-trend up">Active</span>
    </div>
    <div class="stat-value">{{ health.postgres_active_connections }} Conns</div>
    <div class="stat-label">{{ health.postgres_status }}</div>
    <div class="stat-bar"><div class="stat-bar-fill" style="width: 100%; background: #0d9f6e;"></div></div>
  </div>
</div>

<!-- Tab Navigation & Action Button -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border); padding-bottom: 12px; flex-wrap: wrap; gap: 12px;">
  <div style="display: flex; gap: 8px;">
    <a href="?tab=user_reports" class="btn {% if tab == 'user_reports' %}btn-primary{% else %}btn-secondary{% endif %}">
      <i class="fas fa-user-shield"></i> User Reported Errors ({{ counts.total }})
    </a>
    <a href="?tab=system_logs" class="btn {% if tab == 'system_logs' %}btn-primary{% else %}btn-secondary{% endif %}">
      <i class="fas fa-triangle-exclamation"></i> Captured System Exceptions ({{ counts.sys_errors }})
    </a>
    <a href="?tab=server_stream" class="btn {% if tab == 'server_stream' %}btn-primary{% else %}btn-secondary{% endif %}">
      <i class="fas fa-terminal"></i> Live server.log Stream
    </a>
  </div>

  {% if tab == 'user_reports' %}
    <button onclick="document.getElementById('createTicketModal').style.display='flex'" class="btn btn-primary">
      <i class="fas fa-plus"></i> Log New Error Ticket
    </button>
  {% endif %}
</div>

<!-- Admin Create Ticket Modal -->
<div id="createTicketModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:999; justify-content:center; align-items:center; padding:20px;">
  <div class="card" style="width:100%; max-width:560px; background:#fff; border-radius:16px;">
    <div class="card-header">
      <h3><i class="fas fa-plus-circle" style="color:var(--primary);margin-right:8px;"></i>Log New Error Ticket</h3>
      <button onclick="document.getElementById('createTicketModal').style.display='none'" style="background:none; border:none; font-size:18px; cursor:pointer;">&times;</button>
    </div>
    <div class="card-body">
      <form method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:12px;">
        {% csrf_token %}
        <input type="hidden" name="action" value="create_ticket">

        <div>
          <label class="form-label">Title / Summary</label>
          <input type="text" name="title" class="form-control" placeholder="Short error summary">
        </div>

        <div>
          <label class="form-label">User Phone Contact</label>
          <input type="text" name="user_phone" class="form-control" placeholder="+91 XXXXX XXXXX">
        </div>

        <div>
          <label class="form-label">Category</label>
          <select name="category" class="form-control">
            <option value="ui_ux">Screen / UI Glitch</option>
            <option value="backend_api">Backend &amp; API Error</option>
            <option value="notification">Push Notifications Issue</option>
            <option value="network">Network / Connectivity</option>
            <option value="auth">Login &amp; Password Issue</option>
            <option value="schedule_meal">Schedule / Meal Scanner Issue</option>
            <option value="other" selected>Other Service / Linux Issue</option>
          </select>
        </div>

        <div>
          <label class="form-label">Severity</label>
          <select name="severity" class="form-control">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
            <option value="critical">Critical</option>
          </select>
        </div>

        <div>
          <label class="form-label">Error Description *</label>
          <textarea name="description" class="form-control" rows="4" required placeholder="Describe the error in detail..."></textarea>
        </div>

        <div>
          <label class="form-label">Screenshots (optional)</label>
          <input type="file" name="screenshots" multiple class="form-control" accept="image/*">
        </div>

        <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:8px;">
          <button type="button" onclick="document.getElementById('createTicketModal').style.display='none'" class="btn btn-secondary">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Create Ticket</button>
        </div>
      </form>
    </div>
  </div>
</div>

{% if tab == 'user_reports' %}
<!-- TAB 1: User Reported Errors -->
<div class="card">
  <div class="card-header" style="flex-wrap: wrap; gap: 12px;">
    <h3><i class="fas fa-list-check" style="color:var(--primary);margin-right:8px;"></i>User Bug Reports &amp; Screenshots</h3>
    <div style="display: flex; gap: 8px;">
      <a href="?tab=user_reports" class="btn btn-sm {% if not status_filter %}btn-primary{% else %}btn-secondary{% endif %}">All</a>
      <a href="?tab=user_reports&status=new" class="btn btn-sm {% if status_filter == 'new' %}btn-primary{% else %}btn-secondary{% endif %}">New</a>
      <a href="?tab=user_reports&status=in_progress" class="btn btn-sm {% if status_filter == 'in_progress' %}btn-primary{% else %}btn-secondary{% endif %}">In Progress</a>
      <a href="?tab=user_reports&status=resolved" class="btn btn-sm {% if status_filter == 'resolved' %}btn-primary{% else %}btn-secondary{% endif %}">Resolved</a>
    </div>
  </div>
  <div class="card-body" style="padding:0;">
    {% if reports %}
    <table class="data-table">
      <thead>
        <tr>
          <th>User &amp; Date</th>
          <th>Phone Contact</th>
          <th>Category</th>
          <th>Message &amp; Title</th>
          <th>Screenshots</th>
          <th>Severity</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {% for r in reports %}
        <tr>
          <td>
            <div style="font-weight:600;">{{ r.user_name|default:r.user_email }}</div>
            <div style="font-size:11px; color:var(--text-tertiary);">{{ r.user_email }}</div>
            <div style="font-size:11px; color:var(--text-secondary); margin-top:2px;">{{ r.created_at|date:"M d, H:i" }}</div>
          </td>
          <td style="font-size:12px; font-weight:600;">
            {% if r.user_phone %}
              <a href="tel:{{ r.user_phone }}" style="color:var(--primary);"><i class="fas fa-phone"></i> {{ r.user_phone }}</a>
            {% else %}
              <span style="color:var(--text-tertiary);">—</span>
            {% endif %}
          </td>
          <td>
            <span class="badge badge-info">{{ r.get_category_display }}</span>
          </td>
          <td>
            <div style="font-weight:600; color:var(--text);">{{ r.title|truncatechars:45 }}</div>
            <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">{{ r.description|truncatechars:70 }}</div>
          </td>
          <td>
            {% with r.screenshots.all as shots %}
              {% if shots %}
                <div style="display:flex; gap:4px; align-items:center;">
                  {% for s in shots|slice:":2" %}
                    <a href="{{ s.image.url }}" target="_blank">
                      <img src="{{ s.image.url }}" style="width:36px; height:36px; object-fit:cover; border-radius:6px; border:1px solid var(--border);">
                    </a>
                  {% endfor %}
                  {% if shots|length > 2 %}
                    <span class="badge badge-info">+{{ shots|length|add:"-2" }}</span>
                  {% endif %}
                </div>
              {% else %}
                <span style="color:var(--text-tertiary); font-size:12px;">None</span>
              {% endif %}
            {% endwith %}
          </td>
          <td>
            {% if r.severity == 'critical' %}<span class="badge badge-danger">Critical</span>
            {% elif r.severity == 'high' %}<span class="badge badge-warning">High</span>
            {% elif r.severity == 'medium' %}<span class="badge badge-info">Medium</span>
            {% else %}<span class="badge">Low</span>{% endif %}
          </td>
          <td>
            {% if r.status == 'new' %}<span class="badge badge-danger">New</span>
            {% elif r.status == 'in_progress' %}<span class="badge badge-warning">In Progress</span>
            {% elif r.status == 'resolved' %}<span class="badge badge-success">Resolved</span>
            {% else %}<span class="badge">Closed</span>{% endif %}
          </td>
          <td>
            <a href="{% url 'panel_error_report_detail' r.pk %}" class="btn btn-primary btn-sm">
              <i class="fas fa-edit"></i> Edit / View
            </a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="empty-state">
      <i class="fas fa-circle-check" style="color:var(--success);"></i>
      <h3>No Error Reports Found</h3>
      <p>There are currently no active bug reports matching your filters.</p>
    </div>
    {% endif %}
  </div>
</div>

{% elif tab == 'system_logs' %}
<!-- TAB 2: Captured System Exceptions -->
<div class="card">
  <div class="card-header">
    <h3><i class="fas fa-triangle-exclamation" style="color:#dc2626;margin-right:8px;"></i>Auto-Captured Backend &amp; Notification Errors</h3>
    <form method="POST" action="{% url 'panel_clear_system_logs' %}" onsubmit="return confirm('Clear all captured system log entries?');">
      {% csrf_token %}
      <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Clear Log Entries</button>
    </form>
  </div>
  <div class="card-body" style="padding:0;">
    {% if system_logs %}
    <table class="data-table">
      <thead>
        <tr>
          <th>Timestamp</th>
          <th>Type &amp; Level</th>
          <th>Path / Source</th>
          <th>Message &amp; Traceback</th>
          <th>User / IP</th>
        </tr>
      </thead>
      <tbody>
        {% for log in system_logs %}
        <tr>
          <td style="font-size:12px; white-space:nowrap; color:var(--text-tertiary);">{{ log.created_at|date:"M d, H:i:s" }}</td>
          <td>
            {% if log.level == 'CRITICAL' or log.level == 'ERROR' %}
              <span class="badge badge-danger">{{ log.level }}</span>
            {% else %}
              <span class="badge badge-warning">{{ log.level }}</span>
            {% endif %}
            <div style="font-size:11px; font-weight:600; margin-top:2px;">{{ log.get_log_type_display }}</div>
          </td>
          <td style="font-size:12px;">
            <code>{{ log.method }} {{ log.path|default:"Internal Service" }}</code>
          </td>
          <td>
            <div style="font-weight:600; color:var(--danger); font-size:13px;">{{ log.message|truncatechars:80 }}</div>
            {% if log.traceback %}
              <details style="margin-top:4px;">
                <summary style="font-size:11px; color:var(--primary); cursor:pointer;">View Traceback</summary>
                <pre style="background:#1e293b; color:#f8fafc; padding:8px; border-radius:6px; font-size:11px; max-height:160px; overflow:auto; margin-top:4px;">{{ log.traceback }}</pre>
              </details>
            {% endif %}
          </td>
          <td style="font-size:12px;">
            <div>{{ log.user_email|default:"Anonymous" }}</div>
            <div style="color:var(--text-tertiary); font-size:10px;">{{ log.ip_address|default:"" }}</div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="empty-state">
      <i class="fas fa-shield-heart" style="color:var(--success);"></i>
      <h3>Zero System Errors Recorded</h3>
      <p>All backend requests and push services are functioning smoothly.</p>
    </div>
    {% endif %}
  </div>
</div>

{% elif tab == 'server_stream' %}
<!-- TAB 3: Live server.log Stream Console -->
<div class="card">
  <div class="card-header">
    <h3><i class="fas fa-terminal" style="color:var(--primary);margin-right:8px;"></i>Live <code>server.log</code> Viewer (App VM)</h3>
    <div style="display:flex; gap:10px; align-items:center;">
      <span id="last_updated_time" style="font-size:12px; color:var(--text-tertiary);">Polling...</span>
      <button onclick="fetchLogStream()" class="btn btn-secondary btn-sm"><i class="fas fa-rotate"></i> Refresh</button>
      <label style="font-size:12px; display:flex; align-items:center; gap:4px;">
        <input type="checkbox" id="auto_poll_check" checked> Auto-refresh (5s)
      </label>
    </div>
  </div>
  <div class="card-body" style="background:#0f172a; padding:16px;">
    <div id="terminal_box" style="font-family:'Courier New', monospace; font-size:12px; line-height:1.5; color:#38bdf8; max-height:550px; overflow-y:auto; white-space:pre-wrap; word-break:break-all;">
Loading live server logs...
    </div>
  </div>
</div>
{% endif %}

{% endblock %}

{% block scripts %}
<script>
let pollInterval = null;

function fetchLogStream() {
  fetch('/panel/error-reports/live-log-stream/?lines=250')
    .then(r => r.json())
    .then(data => {
      if (data.success && data.lines) {
        const box = document.getElementById('terminal_box');
        if (box) {
          box.innerHTML = data.lines.map(line => {
            if (line.includes('ERROR') || line.includes('Exception') || line.includes('CRITICAL')) {
              return `<span style="color:#f87171;">${escapeHtml(line)}</span>`;
            } else if (line.includes('WARNING') || line.includes('Auto-restarting')) {
              return `<span style="color:#fbbf24;">${escapeHtml(line)}</span>`;
            } else if (line.includes('HTTP/1.1" 200') || line.includes('Application startup complete')) {
              return `<span style="color:#34d399;">${escapeHtml(line)}</span>`;
            }
            return `<span>${escapeHtml(line)}</span>`;
          }).join('\n');
          box.scrollTop = box.scrollHeight;
        }
        const timeEl = document.getElementById('last_updated_time');
        if (timeEl) timeEl.innerText = 'Last updated: ' + data.timestamp;
      }
    })
    .catch(e => console.error("Log stream error:", e));
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.innerText = text;
  return div.innerHTML;
}

document.addEventListener('DOMContentLoaded', () => {
  const autoCheck = document.getElementById('auto_poll_check');
  if (autoCheck) {
    fetchLogStream();
    pollInterval = setInterval(() => {
      if (autoCheck.checked) fetchLogStream();
    }, 5000);
  }
});
</script>
{% endblock %}
