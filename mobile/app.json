{
  "expo": {
    "name": "ETD 2026",
    "slug": "etd2026",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "etd2026",
    "owner": "coder2026s-team",
    "extra": {
      "eas": {
        "projectId": "afa28d7e-10d5-4e85-bed4-783b7371a56b"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.etd2026.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ETD 2026 requires camera access to scan attendee QR codes for event check-in and capture photos for your profile and conference feed.",
        "NSPhotoLibraryUsageDescription": "ETD 2026 requires photo library access to select and upload your profile picture, session presentations, and conference gallery photos.",
        "NSLocationWhenInUseUsageDescription": "ETD 2026 uses your location during the symposium to verify campus checkpoint attendance and navigate interactive selfie spots.",
        "NSMotionUsageDescription": "ETD 2026 uses motion sensors for the shake-to-connect networking feature with nearby attendees.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "android": {
      "package": "com.etd2026.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 4,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "./plugins/withNetworkSecurity.js",
      [
        "expo-notifications",
        {
          "color": "#0333b6",
          "defaultChannel": "default"
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "ETD 2026 requires camera access to scan attendee QR codes for event check-in and capture photos for your profile and conference feed.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withNoMediaPermissions.js"
    ]
  }
}
