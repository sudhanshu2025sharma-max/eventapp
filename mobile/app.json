{
  "expo": {
    "name": "ETD 2026",
    "slug": "etd2026",
    "version": "2.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "etd2026",
    "owner": "coder2026s-team",
    "extra": {
      "eas": {
        "projectId": "afa28d7e-10d5-4e85-bed4-783b7371a56b"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.etd2026.app",
      "buildNumber": "6",
      "infoPlist": {
        "NSCameraUsageDescription": "ETD 2026 uses your camera to scan badge QR codes for check-in and connection exchanges.",
        "NSPhotoLibraryUsageDescription": "ETD 2026 needs access to your photos to let you upload avatar pictures and share photo feed updates.",
        "NSMicrophoneUsageDescription": "ETD 2026 may use your microphone if you record video or audio for event uploads."
      }
    },
    "android": {
      "package": "com.etd2026.app",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0333b6",
          "sounds": []
        }
      ]
    ]
  }
}
