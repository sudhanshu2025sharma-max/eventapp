{
  "expo": {
    "name": "ETD 2026",
    "slug": "etd2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "etd2026",
    "owner": "coder2026s-team",
    "extra": {
      "eas": {
        "projectId": "afa28d7e-10d5-4e85-bed4-783b7371a56b"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.etd2026.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ETD 2026 uses the camera to scan QR codes and take photos.",
        "NSPhotoLibraryUsageDescription": "ETD 2026 needs photo library access to upload photos.",
        "NSPhotoLibraryAddUsageDescription": "ETD 2026 saves photos to your gallery.",
        "NSLocationWhenInUseUsageDescription": "ETD 2026 uses your location to tag selfie point photos.",
        "NSMotionUsageDescription": "ETD 2026 uses motion sensors for shake-to-share contact cards.",
        "NSFaceIDUsageDescription": "ETD 2026 uses Face ID to protect admin actions."
      }
    },
    "android": {
      "package": "com.etd2026.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/withNetworkSecurity.js",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ]
  }
}
